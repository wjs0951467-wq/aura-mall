# PostgreSQL 연동 실험(/lab/products)용 예시 파일입니다. 실제 값은 넣지 마세요.
# 이 파일을 복사해 같은 폴더에 .env 파일을 만들고, .env에만 실제 비밀번호를 입력합니다.
# (.env는 .gitignore의 `.env*` 규칙으로 Git에서 제외됩니다.)
#
# 형식: postgresql://<사용자>:<비밀번호>@<호스트>:<포트>/<DB이름>?schema=public
# 비밀번호에 @ : / # ? % 같은 특수문자가 있으면 URL 인코딩해야 합니다. (예: @ → %40)
# DB 이름은 반드시 aura_mall_lab 이어야 합니다. 다른 DB를 가리키면 시드·화면이 실행을 거부합니다.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/aura_mall_lab?schema=public"

# 운영 빌드(next start)에서 /lab/products를 열 때만 true로 설정합니다. 개발 서버(npm run dev)에서는 불필요합니다.
# ENABLE_DB_LAB="true"
